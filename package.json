{
  "name": "artboard-inspector",
  "displayName": "Artboard Inspector",
  "description": "View and inspect design files inside VS Code — Adobe XD (.xd) and Figma local copies (.fig): artboards, layers, sizes, spacing, colors, fonts and CSS. Works offline.",
  "version": "0.2.0",
  "publisher": "thai1108",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0A1A33",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thai1108/vscode-artboard-inspector.git"
  },
  "homepage": "https://github.com/thai1108/vscode-artboard-inspector#readme",
  "bugs": {
    "url": "https://github.com/thai1108/vscode-artboard-inspector/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "xd",
    "adobe xd",
    "fig",
    "figma",
    "design",
    "inspect",
    "handoff",
    "redline",
    "css",
    "artboard"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "artboardInspector.xd",
        "displayName": "Artboard Inspector",
        "selector": [
          {
            "filenamePattern": "*.xd"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "artboardInspector.fig",
        "displayName": "Artboard Inspector",
        "selector": [
          {
            "filenamePattern": "*.fig"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . && tsc -p src/webview",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.ts",
    "preview": "node esbuild.mjs && node scripts/preview.ts",
    "sample": "node scripts/sample-xd.ts",
    "package": "pnpm check && vsce package --no-dependencies"
  },
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
